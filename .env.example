# Leave blank to use Vite's local API routes and cloud-saving proxy.
VITE_API_BASE_URL=
# Server only. Put your actual key in .env.local, never in a VITE_ variable.
OPENAI_API_KEY=

# Speech is hidden in development and production for launch.
# Set true to re-enable the retained speech feature when it is ready.
VITE_SPEECH_ENABLED=false

# Supabase public frontend configuration (safe to bundle).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
